# Copy this file to ".env.local" and adjust. ".env.local" is not committed to Git.
# After changing a value, stop and restart "npm run dev".

# Address of the API as seen from the visitor's BROWSER
NEXT_PUBLIC_API_URL=http://localhost:5080

# Address of the API as seen from the Next.js SERVER (optional; defaults to NEXT_PUBLIC_API_URL).
# Useful when the website and the API talk over a private network, for example in Docker.
# API_URL=http://localhost:5080

# The public address of this website. Used for share previews, canonical links and the sitemap.
# In production this must be your real address, for example https://shop.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Currency code for Google product data (for example BDT or USD). Optional:
# without it, prices are left out of the product data that search engines read.
# NEXT_PUBLIC_CURRENCY=BDT
