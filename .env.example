# Copy this file to ".env" and fill it in:   cp .env.example .env
# NEVER commit ".env" (it is in .gitignore). It contains your secrets.
#
# Make strong random values with:   openssl rand -hex 32
# (Use only letters and digits in passwords. Characters like ; or = would break the database address.)

# --- Where the site lives ---
# To try it on your own computer (http, no certificate):
SITE_ADDRESS=http://localhost
SITE_URL=http://localhost
# On a real server with a domain name pointing to it (Caddy gets the https certificate automatically):
#   SITE_ADDRESS=shop.example.com
#   SITE_URL=https://shop.example.com

# --- Secrets ---
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
# At least 32 characters. Anyone who knows this can create login tokens for any account.
JWT_KEY=

# --- Optional ---
# Currency code for prices in the data search engines read (for example BDT or USD)
CURRENCY=

# --- Email (needed for "forgot password") ---
# Without SMTP_HOST, no email is sent and password reset does not work in production.
# Any SMTP service works (your hosting provider, SendGrid, Mailgun, Brevo, Gmail with an app password ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The address the emails come from, for example no-reply@shop.example.com
SMTP_FROM=
